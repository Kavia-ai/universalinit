{"is_source_file": true, "format": "bash script", "description": "A shell script for setting up, initializing, and managing a MySQL server instance with checks for existing processes, socket connections, and database configuration. It automates startup, database creation, user setup, and environment variable generation.", "external_files": ["db_connection.txt", "db_visualizer/mysql.env"], "external_methods": ["mysqladmin", "mysql", "mysqld", "mysqladmin shutdown"], "published": [], "classes": [], "methods": [], "calls": ["sudo mysqladmin ping", "sudo mysql --socket=/var/run/mysqld/mysqld.sock -e \"USE ${DB_NAME};\"", "pgrep -f \"mysqld.*--port=${DB_PORT}\"", "mysql -u root -p${DB_PASSWORD} -h 127.0.0.1 -P ${DB_PORT} -e \"SELECT 1;\"", "sudo mysql --socket=/var/run/mysqld/mysqld.sock -e \"SHOW VARIABLES LIKE 'port';\"", "sudo mysqld --initialize-insecure --user=mysql --datadir=/var/lib/mysql", "sudo mysqld --user=mysql --datadir=/var/lib/mysql --socket=/var/run/mysqld/mysqld.sock --pid-file=/var/run/mysqld/mysqld.pid --port=${DB_PORT}", "sudo mysqladmin ping --socket=/var/run/mysqld/mysqld.sock --silent", "sudo mysql --socket=/var/run/mysqld/mysqld.sock << EOF ... EOF", "cat > db_visualizer/mysql.env << EOF ... EOF"], "search-terms": ["mysqld", "startup.sh", "MySQL server", "database setup", "mysqladmin", "mysqld socket"], "state": 2, "file_id": 484, "knowledge_revision": 2063, "git_revision": "93871d1eed04991c64fbd0239512f1839d53c610", "hash": "ee15961aa0bd2f6ec7099cb4bae5cc4d", "format-version": 4, "code-base-name": "universalinit", "filename": "src/universalinit/templates/mysql/startup.sh", "revision_history": [{"2063": "93871d1eed04991c64fbd0239512f1839d53c610"}]}